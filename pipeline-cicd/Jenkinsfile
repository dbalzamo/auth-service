pipeline {
    agent any   // esegue direttamente nel container Jenkins (jenkins-docker-kubectl)

    tools {
        // Se non già presente, Jenkins scarica e installa Maven da solo
        // al primo utilizzo (Manage Jenkins > Tools > Maven installations,
        // con "Install automatically" spuntato, nome esatto: Maven-3.9)
        maven 'Maven-3.9'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        DOCKER_REGISTRY = 'host.docker.internal:8082'
        IMAGE_NAME = 'auth-service'
        IMAGE_TAG = "develop-${BUILD_NUMBER}"
    }

    stages {

        stage('Build & Unit Test') {
            steps {
                sh 'mvn -B clean verify'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Quality Gate (SonarQube)') {
            steps {
                withSonarQubeEnv('sonarqube-server') {
                    sh 'mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn -B package -DskipTests'
            }
        }

        stage('Publish artefatto su Nexus') {
            steps {
                // settings.xml versionato nel repo (pipeline-cicd/settings.xml), con
                // ${env.NEXUS_USER} / ${env.NEXUS_PASS} come placeholder:
                // nessuna credenziale in chiaro nel file, Maven li risolve
                // da solo leggendo le variabili d'ambiente a runtime.
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-deployer',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh 'mvn -B -s pipeline-cicd/settings.xml deploy -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} . '
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    trivy image \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Docker Push to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        echo "$NEXUS_PASS" | docker login \
                            ${DOCKER_REGISTRY} \
                            -u "$NEXUS_USER" \
                            --password-stdin

                        docker push ${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "Pipeline completata: artefatto e immagine pubblicati."
        }
        failure {
            echo "Pipeline fallita: controllare i log dello stage in errore."
        }
    }
}